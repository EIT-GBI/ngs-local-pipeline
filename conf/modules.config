// conda / container enablement is decided by the active profile in nextflow.config.
// Each label declares BOTH a conda spec and a matching public container image, so
// `-profile conda`, `-profile docker`, and `-profile apptainer` all work.
// Containers are pulled directly from public registries (no build/push):
//   - single tools: quay.io/biocontainers (exact pinned versions)
//   - bwa+samtools (alignment): nf-core's public Seqera Wave image (bwa 0.7.19 / samtools 1.22.1)

process {
    withLabel: fastqc {
        conda = 'bioconda::fastqc=0.12.1'
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }

    withLabel: fastp {
        conda = 'bioconda::fastp=0.23.4'
        container = 'quay.io/biocontainers/fastp:0.23.4--h125f33a_5'
        ext.args = '--trim_poly_g --trim_poly_x --adapter_sequence AGATCGGAAGAGCACACGTCTGAACTCCAGTCA --adapter_sequence_r2 AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT'
    }

    withLabel: bwa {
        conda = 'bioconda::bwa=0.7.18'
        container = 'quay.io/biocontainers/bwa:0.7.18--h577a1d6_2'
    }

    withLabel: bwa_samtools {
        // No public image carries the exact pinned bwa 0.7.18 + samtools 1.20 combo;
        // this Seqera Wave image (used by nf-core/bwa/mem) has bwa 0.7.19 + samtools 1.22.1.
        conda = 'bioconda::bwa=0.7.18 bioconda::samtools=1.20'
        container = 'community.wave.seqera.io/library/bwa_htslib_samtools:83b50ff84ead50d0'
    }

    withLabel: samtools {
        conda = 'bioconda::samtools=1.20'
        container = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_1'
    }

    withLabel: bcftools {
        conda = 'bioconda::bcftools=1.20'
        container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_1'
    }

    withLabel: bedtools {
        conda = 'bioconda::bedtools=2.31.1'
        container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
    }

    withLabel: ucsc_bedgraphtobigwig {
        conda = 'bioconda::ucsc-bedgraphtobigwig=482'
        container = 'quay.io/biocontainers/ucsc-bedgraphtobigwig:482--hdc0a859_0'
    }

    withLabel: multiqc {
        conda = 'bioconda::multiqc=1.33'
        container = 'quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
    }

    withLabel: process_high {
        cpus = 4
        // 8.GB, not '8 GB': `memory` is typed MemoryUnit, and the language
        // server flags the String form. Nextflow coerces it at runtime, so this
        // is a type correctness fix, not a behaviour change — and it matches the
        // MemoryUnit literals used everywhere else (see ALIGNMENT_BWA below).
        memory = 8.GB
    }

    // Alignment can OOM on large (e.g. human) references: bwa loads the whole index
    // and samtools sort buffers on top. Start modest and retry with more memory so
    // small bacterial samples stay cheap while large ones escalate as needed.
    withName: 'ALIGNMENT_BWA' {
        cpus          = 4
        memory        = { 16.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
