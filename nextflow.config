params {
    samplesheet   = null
    publish_dir   = null
    analysis_name = null
    min_depth     = 10
    min_qmap      = 20
    min_qual      = 20
    reads_dir     = null
    ref_dir       = null

    // Registry/namespace prefix for the per-tool container images.
    // Local builds (containers/build.sh) tag under "ngs-seq" by default.
    // For Apptainer/Slurm this MUST be a real registry the cluster can pull from,
    // e.g. --container_registry ghcr.io/my-org/ngs-seq
    container_registry = 'ngs-seq'

    // --- Cluster / Apptainer settings (used by the apptainer & slurm profiles) ---
    // Shared dir where Apptainer caches pulled .sif images so all nodes reuse them.
    apptainer_cachedir = null
    // Extra bind paths inside containers (e.g. your shared mount), comma-separated.
    apptainer_bind     = null
    // Slurm partition/queue. Left null = use the cluster default partition.
    partition          = null
    // Extra options appended to every sbatch, e.g. '--account=gbi --qos=normal'.
    clusteropts        = null
}

// Included after params so module container directives can resolve
// ${params.container_registry}.
includeConfig 'conf/modules.config'

outputDir = "${params.publish_dir}/${params.analysis_name}"

process {
    executor = 'local'
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        apptainer.enabled = false
        // Run as the invoking user so output files aren't owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor  = 'local'
        // Fallback image for label-less, script-based processes
        // (CHROM_SIZES, PARSE_ALIGNMENT_LOG). withLabel containers override this.
        process.container = "${params.container_registry}/base:1.0"
    }

    // Container runtime for HPC. Composable with the slurm profile:
    //   -profile apptainer,slurm
    // Apptainer auto-pulls each `container` value via `docker://`, so
    // params.container_registry must point at a registry the cluster can reach.
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        // null cacheDir/runOptions = Apptainer defaults (no extra binds, default cache).
        apptainer.cacheDir   = params.apptainer_cachedir
        apptainer.runOptions = params.apptainer_bind ? "-B ${params.apptainer_bind}" : null
        // Default image for label-less, script-based processes; labels override it.
        process.container = "${params.container_registry}/base:1.0"
    }

    // Slurm executor. Closures resolve at submit time; null params fall back to
    // cluster defaults (no -p / no extra sbatch options).
    slurm {
        process.executor       = 'slurm'
        process.queue          = { params.partition }
        process.clusterOptions = { params.clusteropts }
    }
}