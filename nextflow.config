params {
    samplesheet   = null
    publish_dir   = null
    analysis_name = null
    min_depth     = 10
    min_qmap      = 20
    min_qual      = 20
    reads_dir     = null
    ref_dir       = null

    // Registry/namespace prefix for the per-tool container images.
    // Local builds (containers/build.sh) tag under "ngs-seq" by default.
    // Override for a remote registry, e.g. --container_registry ghcr.io/my-org/ngs-seq
    container_registry = 'ngs-seq'
}

// Included after params so module container directives can resolve
// ${params.container_registry}.
includeConfig 'conf/modules.config'

outputDir = "${params.publish_dir}/${params.analysis_name}"

process {
    executor = 'local'
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
        // Run as the invoking user so output files aren't owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
        // Fallback image for label-less, script-based processes
        // (CHROM_SIZES, PARSE_ALIGNMENT_LOG). withLabel containers override this.
        process.container = "${params.container_registry}/base:1.0"
    }
}